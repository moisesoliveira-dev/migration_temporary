# Gosac (próprio deste projeto — não reutilizar .env de outros repos)
GOSAC_BASE_URL=https://cmmodulados.gosac.com.br
GOSAC_API_KEY=sua_api_key_aqui
GOSAC_TIMEOUT_MS=120000
GOSAC_RETRIES=3
GOSAC_RETRY_DELAY_MS=2000

# Controle one-shot: true = roda a migração | false = sobe e encerra sem migrar
MIGRATE_ENABLED=false
MEDIA_MIGRATE_ENABLED=false

# Painel web (sync contínuo / diário / jobs). true = processo persistente.
CONTROL_PANEL=false
PORT=3847
# Opcional: protege a API do painel (Bearer / x-admin-token / ?token=)
# ADMIN_TOKEN=troque-isto

# CouchDB — use gosac_messages (não gosac_geral) para o destino das msgs
COUCHDB_URL=http://admin:password@localhost:5984
COUCHDB_DATABASE=gosac_messages
# Database onde os arquivos (attachments) serão gravados
COUCHDB_MEDIA_DATABASE=gosac_media

# Opcional: persistir settings/checkpoint do painel
# CONTROL_SETTINGS_FILE=.control-settings.json
# MIGRATION_STATE_FILE=.migration-state.json
