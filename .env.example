# Gosac (próprio deste projeto — não reutilizar .env de outros repos)
GOSAC_BASE_URL=https://cmmodulados.gosac.com.br
GOSAC_API_KEY=sua_api_key_aqui
GOSAC_TIMEOUT_MS=120000
GOSAC_RETRIES=3
GOSAC_RETRY_DELAY_MS=2000

# Controle: true = roda a migração | false = sobe e encerra sem migrar
MIGRATE_ENABLED=false

# CouchDB
COUCHDB_URL=http://admin:password@localhost:5984
COUCHDB_DATABASE=gosac_messages
